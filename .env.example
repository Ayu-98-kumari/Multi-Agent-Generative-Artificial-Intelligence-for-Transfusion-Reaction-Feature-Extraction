# Copy this file to .env (same folder) and fill in your own keys:
#   cp .env.example .env
# .env is gitignored -- never commit real keys.

# Groq -- needed for the qwen and gpt-oss-120b runs and every Groq-backed stage.
GROQ_API_KEY=your_groq_key_here

# OpenRouter -- needed only for the Kimi K3 run in model_evaluation_pipeline.
OPENROUTER_API_KEY=your_openrouter_key_here
